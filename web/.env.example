# Sanity CMS — copy to .env.local (never commit .env.local).
# Without a project ID the site still builds and shows the copy that ships in
# code; /studio explains what is missing. Setup steps: SANITY.md.

# From sanity.io/manage → your project. Not secret: it is in every image URL.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# A token with the VIEWER role only (sanity.io/manage → API → Tokens). It lets
# preview read drafts, and while preview is on it is also handed to that
# browser so the preview updates live — so never use an Editor or Deploy token
# here. Without it, preview is off and the live site still works.
SANITY_API_READ_TOKEN=

# REQUIRED whenever a project ID is set. The secret of the publish webhook
# (SANITY.md, step 6): without it a publish only reaches the site while
# someone happens to have it open.
SANITY_REVALIDATE_SECRET=
